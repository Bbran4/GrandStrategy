extends SceneTree
const Importer = preload("res://scripts/provinces/opengs_importer.gd")
const Fixture = preload("res://tests/opengs_fixture.gd")
var failures: Array[String] = []
func _initialize() -> void: call_deferred("_run")
func check(value: bool, message: String) -> void:
	if not value:
		failures.append(message)
		push_error(message)
func _run() -> void:
	var folder = "res://tests/output/province_import_" + str(Time.get_ticks_usec())
	var fixture = Fixture.create(folder)
	var result = Importer.load_folder(folder, fixture.heightmap, fixture.settings)
	check(result.error.is_empty(), "Valid OpenGS maps must import: " + str(result.error))
	if not result.error.is_empty(): quit(1); return
	var data = result.data
	check(data.provinces.size() == 5 and data.territories.size() == 3, "Four provinces and two territories plus reserved void entries")
	var a = data.province_at_pixel(Vector2i(1,1))
	var b = data.province_at_pixel(Vector2i(6,1))
	var c = data.province_at_pixel(Vector2i(1,6))
	var d = data.province_at_pixel(Vector2i(6,6))
	check(data.provinces[a].id == "PRV_A" and data.provinces[d].id == "PRV_D", "Original OpenGS province IDs must survive import")
	check(data.provinces[a].territory_id == "TRT_NORTH" and data.provinces[c].territory_id == "TRT_SOUTH", "Territory membership must follow the raster")
	check(data.provinces[a].neighbours.size() == 2 and "PRV_B" in data.provinces[a].neighbours and "PRV_C" in data.provinces[a].neighbours, "Adjacency requires shared edges, not diagonal corners")
	check(not "PRV_D" in data.provinces[a].neighbours, "Corner-touching provinces are not neighbours")
	check(data.provinces[a].shared_borders.PRV_B == 2.0 and data.provinces[b].shared_borders.PRV_A == 2.0, "Shared border lengths must be symmetric and use world units")
	check(data.provinces[a].area_m2 == 4.0, "Province area must reflect pixel spacing")
	check(data.province_at_world(Vector3(0.75, 100, 0.75)) == a, "World XZ picking must respect half-metre samples")
	check(data.province_at_world(Vector3(-0.01,0,1)) == 0 and data.province_at_world(Vector3(4,0,1)) == 0, "Outside coordinates must not wrap or clamp into a province")
	check(data.provinces[a].terrain == "forest", "Terrain metadata must survive import")
	check(data.border_distance_image.get_size() == Vector2i(8,8) and data.border_distance_image.get_pixel(3,1).r == 0, "Separate border distance field must align with exact region IDs")
	var ids_before = data.province_index_image.get_data()
	check(data.set_owner(a, "ROM", Color("aa3344")), "Ownership assignment must succeed")
	check(data.set_owner(b, "ROM", Color("bb4455")), "A second province may share a country")
	check(data.provinces[b].owner_color == "aa3344", "Joining an existing country must keep its color")
	check(data.set_owner(a, "ROM", Color("bb4455")), "Existing country palette may be recolored explicitly")
	check(data.provinces[a].owner_color == "bb4455" and data.provinces[a].owner_index == data.provinces[b].owner_index, "One country must have consistent color and identity")
	check(data.province_index_image.get_data() == ids_before, "Ownership must not repaint province identity")
	var saved = folder.path_join("saved")
	check(data.save_to_folder(saved) == OK, "Province package must save")
	var reloaded = Importer.load_folder(saved, fixture.heightmap, fixture.settings)
	check(reloaded.error.is_empty(), "Saved package must be re-importable: " + reloaded.error)
	if reloaded.error.is_empty():
		var re_a = reloaded.data.province_at_pixel(Vector2i(1,1))
		check(reloaded.data.provinces[re_a].owner == "ROM" and reloaded.data.provinces[re_a].owner_color == "bb4455", "Saved ownership must restore")
		check(reloaded.data.province_index_image.get_data() == ids_before, "Saved province identity must restore exactly")
	Fixture.write_json(folder.path_join("opengs_export.json"), {"heightmap_sha256": "wrong", "source_settings": fixture.settings})
	check(not Importer.load_folder(folder, fixture.heightmap, fixture.settings).error.is_empty(), "Mismatched source heightmap must be rejected")
	DirAccess.remove_absolute(folder.path_join("opengs_export.json"))
	Fixture.write_json(folder.path_join("territory_history.json"), {"TRT_NORTH": {"provinces": ["PRV_A"]}, "TRT_SOUTH": {"provinces": ["PRV_C", "PRV_D"]}})
	check(not Importer.load_folder(folder, fixture.heightmap, fixture.settings).error.is_empty(), "Incorrect territory history must be rejected")
	DirAccess.remove_absolute(folder.path_join("territory_history.json"))
	fixture.provinces.set_pixel(0,0,Color8(1,2,3))
	fixture.provinces.save_png(folder.path_join("provinces.png"))
	check(not Importer.load_folder(folder, fixture.heightmap, fixture.settings).error.is_empty(), "Undeclared palette colors must be rejected")
	fixture = Fixture.create(folder)
	fixture.territories.set_pixel(0,0,Color8(60,80,170))
	fixture.territories.save_png(folder.path_join("territories.png"))
	check(not Importer.load_folder(folder, fixture.heightmap, fixture.settings).error.is_empty(), "A province crossing territories must be rejected")
	fixture = Fixture.create(folder)
	var wrong_size = Image.create_empty(4,4,false,Image.FORMAT_RGB8)
	wrong_size.save_png(folder.path_join("territories.png"))
	check(not Importer.load_folder(folder, fixture.heightmap, fixture.settings).error.is_empty(), "Resolution mismatch must be rejected")
	fixture = Fixture.create(folder)
	var alpha = fixture.provinces.duplicate()
	alpha.convert(Image.FORMAT_RGBA8)
	alpha.set_pixel(0,0,Color(1,0,0,0.5))
	alpha.save_png(folder.path_join("provinces.png"))
	check(not Importer.load_folder(folder, fixture.heightmap, fixture.settings).error.is_empty(), "Transparent images must be rejected")
	var plain = Fixture.create(folder.path_join("images_only"), 8,8,false)
	var inferred = Importer.load_folder(folder.path_join("images_only"), plain.heightmap, plain.settings)
	check(inferred.error.is_empty() and inferred.data.warnings.size() > 0, "Images-only import must derive deterministic IDs and flag absent alignment manifest")
	if inferred.error.is_empty(): check(inferred.data.provinces[inferred.data.province_at_pixel(Vector2i(1,1))].id == "PRV_C80A14", "Image-only IDs must be stable by RGB color")
	var lake_folder = folder.path_join("lake_overlap")
	var lake = Fixture.create(lake_folder)
	var definitions = JSON.parse_string(FileAccess.get_file_as_string(lake_folder.path_join("province_definitions.json")))
	definitions.PRV_A.province_type = "lake"
	Fixture.write_json(lake_folder.path_join("province_definitions.json"), definitions)
	lake.territories.set_pixel(0,0,Color8(60,80,170))
	lake.territories.save_png(lake_folder.path_join("territories.png"))
	var overlap = Importer.load_folder(lake_folder, lake.heightmap, lake.settings)
	check(overlap.error.is_empty(), "Whole-lake provinces must support overlapping raw territories")
	if overlap.error.is_empty():
		var index = overlap.data.province_at_pixel(Vector2i(0,0))
		check(overlap.data.provinces[index].territory_id == "TRT_NORTH" and overlap.data.territory_pixels[0] == overlap.data.provinces[index].territory_index, "Lake parent must normalize the in-game territory map consistently")
	Fixture.write_json(lake_folder.path_join("territory_history.json"), {"TRT_NORTH": {"provinces": ["PRV_B"]}, "TRT_SOUTH": {"provinces": ["PRV_A", "PRV_C", "PRV_D"]}})
	overlap = Importer.load_folder(lake_folder, lake.heightmap, lake.settings)
	check(overlap.error.is_empty(), "Explicit lake parent from OpenGS history must be respected")
	if overlap.error.is_empty():
		var index = overlap.data.province_at_pixel(Vector2i(1,1))
		check(overlap.data.provinces[index].territory_id == "TRT_SOUTH", "History must take precedence over source center")
		check(overlap.data.save_to_folder(lake_folder.path_join("saved")) == OK, "Normalized lake package must save")
		var restored = Importer.load_folder(lake_folder.path_join("saved"), lake.heightmap, lake.settings)
		check(restored.error.is_empty() and restored.data.territory_pixels == overlap.data.territory_pixels, "Saved lake membership must round-trip")
	print("PROVINCE IMPORT TESTS: ", "PASS" if failures.is_empty() else failures)
	quit(0 if failures.is_empty() else 1)
