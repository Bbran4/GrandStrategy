extends SceneTree
const Progression = preload("res://scripts/countries/nation_progression.gd")
const Store = preload("res://scripts/countries/country_store.gd")
var failures: Array[String] = []
func check(value: bool, message: String) -> void:
	if not value: failures.append(message); push_error(message)
func _initialize() -> void: call_deferred("_run")
func _run() -> void:
	var model = Progression.new()
	check(model.errors.is_empty() and model.nodes.size()==30,"Catalogue must contain 30 valid nodes")
	check(not model.unlock("longships").is_empty() and model.unlocked.is_empty(),"Prerequisites must block without charging points")
	for id in ["clinker_hulls","longships","warband_customs","sea_raiders"]: check(model.unlock(id).is_empty(),"Valid prerequisite chain should unlock: " + id)
	check(model.spent("technology")==180 and model.spent("national")==3,"Currencies must be charged separately")
	check(not model.unlock("sea_raiders").is_empty() and model.spent("national")==3,"Duplicate unlock must not charge twice")
	check(model.unlock("shield_wall").is_empty(),"Another technology branch must be available")
	check(model.blocked_reason("border_reavers").contains("Alternative"),"Specialties in a national branch are exclusive")
	check(is_equal_approx(model.effects().raid_loot,0.2),"Effect preview must sum modifiers accurately")
	var saved = model.plan()
	var roundtrip = Progression.new()
	check(roundtrip.load_plan(saved).is_empty() and roundtrip.plan()==saved,"Plan should round-trip exactly")
	var removed = model.remove("clinker_hulls")
	check("longships" in removed and "sea_raiders" in removed and "warband_customs" in model.unlocked,"Removing a tech must refund cross-tree dependents, retaining independent nodes")
	check(model.spent("technology")==60 and model.spent("national")==1,"Cascade refunds must be exact")
	var before = model.plan()
	var bad = before.duplicate(true); bad.unlocks.append("unknown")
	check(not model.load_plan(bad).is_empty() and model.plan()==before,"Invalid plan load must be transactional")
	bad = before.duplicate(true); bad.research_budget=-1
	check(not model.load_plan(bad).is_empty(),"Negative budgets reject")
	bad = before.duplicate(true); bad.skill_budget=2.5
	check(not model.load_plan(bad).is_empty(),"Fractional budgets reject")
	var poor = Progression.new(); poor.research_budget=59
	check(not poor.unlock("clinker_hulls").is_empty() and poor.remaining("technology")==59,"Insufficient budget must not mutate state")
	var definition = JSON.parse_string(FileAccess.get_file_as_string(Progression.PATH))
	definition.nodes[0].requires = ["water_mills"]
	var cyclic = Progression.new(definition)
	check(not cyclic.errors.is_empty(),"Prerequisite cycles must reject")
	var country = Store.blank(); country.id="PLANNER"; country.name="Planner tribe"; country.adjective="Planning"
	country.build_plan=saved.duplicate(true)
	var folder = "res://tests/output/progression_"+str(Time.get_ticks_usec())
	check(Store.save_country(country,folder).is_empty(),"Country must save a valid build plan")
	var reloaded_plan = Progression.new()
	check(reloaded_plan.load_plan(Store.load_library(folder).records[0].build_plan).is_empty() and reloaded_plan.plan()==saved,"Build plan must survive country file reload")
	country.build_plan.unlocks.append("unknown")
	check(not Store.validate(country).is_empty(),"Country validation must reject invalid build plans")
	var legacy = country.duplicate(true); legacy.erase("build_plan")
	check(Store.validate(legacy).is_empty(),"Older country definitions without plans remain compatible")
	var creator = load("res://scenes/country_creator.tscn").instantiate()
	creator.storage_directory = folder
	root.add_child(creator)
	creator._edit(legacy,"PLANNER")
	var planner = creator.get_node("ProgressionPlanner")
	planner.open_plan(saved)
	await process_frame
	check(planner.visible and planner.get_node("%Canvas").get_child_count()==20,"Planner must display technology nodes")
	planner.get_node("%TreeKind").select(1)
	planner.get_node("%TreeKind").item_selected.emit(1)
	check(planner.get_node("%Canvas").get_child_count()==20,"Planner must display national nodes")
	planner.selected="sea_raiders"; planner._refresh()
	check(planner.get_node("%Details").text.contains("Longships") and planner.get_node("%Unlock").disabled,"Details must show cross-tree prerequisites and unlock status")
	planner._set_budget("technology",0)
	check(planner.model.research_budget==1200,"UI must not reduce budget below spent research")
	planner.get_node("%UsePlan").pressed.emit()
	check(not planner.visible and creator._collect().build_plan==saved,"Applying preview should update the country form")
	check(creator._collect().government=="tribal","Plans must not reform the starting government")
	check(creator._collect()!=creator.baseline,"Applying a new plan must mark the country form changed")
	check(creator._save(),"Country form should save the applied build plan")
	var stored = Store.load_library(folder).records[0].build_plan
	var stored_model = Progression.new()
	check(stored_model.load_plan(stored).is_empty() and stored_model.plan()==saved,"UI-applied build plan must round-trip through the country library")
	planner.open_plan(saved)
	planner.model.unlocked.clear()
	planner.get_node("%Cancel").pressed.emit()
	check(creator._collect().build_plan==saved,"Canceling a preview must leave saved country choices intact")
	creator.queue_free()
	await process_frame
	print("NATION PROGRESSION TESTS: ","PASS" if failures.is_empty() else failures)
	quit(0 if failures.is_empty() else 1)
